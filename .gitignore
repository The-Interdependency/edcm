# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Python package build outputs
build/
dist/
*.egg-info/

# Raw real-system corpora and resumable local checkpoints
experiments/corpora/raw/
experiments/corpora/checkpoints/
*.corpus-checkpoint.json

# Reproducible full lexical-floor materializations (receipts are copied to
# experiments/ after byte-identical replay; large branch carriers stay cached).
generated/

# Generated corpus/artifact materializations; keep only directory guidance.
/artifacts/*
!/artifacts/README.md
!/artifacts/tarot/
/artifacts/tarot/*
!/artifacts/tarot/README.md

# OS / editor cruft
.DS_Store

# Local secrets
.env
